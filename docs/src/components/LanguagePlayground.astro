---
import { languages } from '../data/languages';
---

<div class="playground">
  <div class="controls">
    <label>
      Language
      <select id="playground-lang">
        <option value="">Browser default</option>
        {languages.map((lang) => (
          <option value={lang.code}>{lang.name}</option>
        ))}
      </select>
    </label>
    <label>
      Theme
      <select id="playground-theme">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
    </label>
  </div>
  <div class="preview">
    <iframe
      id="playground-frame"
      title="Preferred source button preview"
      data-base={import.meta.env.BASE_URL}
    ></iframe>
  </div>
  <p class="note">
    The button text is localized by Google. Selecting a language sets <code>data-lang</code>;
    theme sets <code>data-theme</code>. Google's script scans the page once at load, so the
    preview re-renders inside an isolated frame on every change.
  </p>
</div>

<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 1rem;
    align-items: stretch;
  }
  .controls {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .controls label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .controls select {
    width: 100%;
    min-height: 2.85rem;
    background: #fff;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    padding: 0.55rem 0.7rem;
    font-size: 0.96rem;
    font-weight: 700;
  }
  .preview {
    min-width: 0;
    min-height: 9rem;
    padding: 1.25rem;
    background:
      linear-gradient(90deg, rgba(18, 129, 58, 0.08), transparent 45%),
      #f8fafc;
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .preview iframe {
    border: 0;
    width: 100%;
    height: 72px;
    background: transparent;
    color-scheme: normal;
  }
  .note {
    grid-column: 1 / -1;
    margin: 0;
  }
  @media (max-width: 760px) {
    .playground {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const frame = document.getElementById('playground-frame') as HTMLIFrameElement | null;
  const langSelect = document.getElementById('playground-lang') as HTMLSelectElement | null;
  const themeSelect = document.getElementById('playground-theme') as HTMLSelectElement | null;

  function render() {
    if (!frame) return;
    const lang = langSelect?.value || '';
    const theme = themeSelect?.value || 'light';
    const params = new URLSearchParams({ theme });
    const rawBase = frame.dataset.base || '/';
    const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
    if (lang) params.set('lang', lang);
    frame.src = `${base}playground/frame/?${params}`;
  }

  langSelect?.addEventListener('change', render);
  themeSelect?.addEventListener('change', render);
  render();
</script>
