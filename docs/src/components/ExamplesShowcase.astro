---
import GooglePreferredSourceDeeplink from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceDeeplink.astro';
import GoogleIcon from '@puralex/astro-google-preferred-source/components/GoogleIcon.astro';

const exampleSite = 'magnifito.github.io';
---

<div class="showcase-container">
  <div class="showcase-nav" role="tablist" aria-label="Examples Categories">
    <button class="tab-btn active" data-tab="buttons" role="tab" aria-selected="true">
      <span class="tab-icon">✨</span> Button Variants
    </button>
    <button class="tab-btn" data-tab="layouts" role="tab" aria-selected="false">
      <span class="tab-icon">🎨</span> Custom Layouts
    </button>
    <button class="tab-btn" data-tab="exotic" role="tab" aria-selected="false">
      <span class="tab-icon">⚡</span> Exotic & Experimental
    </button>
  </div>

  <!-- TAB 1: BUTTON VARIANTS -->
  <div class="tab-pane active" id="tab-buttons">
    <div class="examples-grid">
      <!-- 1. Modern Pill -->
      <div class="example-card">
        <div class="example-header">
          <h4>Modern Stadium Pill</h4>
          <span class="badge-tag">variant="pill"</span>
        </div>
        <p class="example-desc">Crisp vector Google 'G' icon with arbitrary text and smooth hover elevation.</p>
        <div class="example-preview center-preview">
          <GooglePreferredSourceDeeplink
            url={exampleSite}
            variant="pill"
            label="Follow on Google"
            theme="light"
          />
        </div>
        <pre class="code-block"><code>{`<GooglePreferredSourceDeeplink
  url="your-site.com"
  variant="pill"
  label="Follow on Google"
  theme="light"
/>`}</code></pre>
      </div>

      <!-- 2. Dark Solid Button -->
      <div class="example-card">
        <div class="example-header">
          <h4>Dark Solid Button</h4>
          <span class="badge-tag">variant="button"</span>
        </div>
        <p class="example-desc">Dark mode rectangular button with rounded corners and arbitrary localized text.</p>
        <div class="example-preview center-preview dark-bg">
          <GooglePreferredSourceDeeplink
            url={exampleSite}
            variant="button"
            label="선호하는 출처로 추가"
            theme="dark"
          />
        </div>
        <pre class="code-block"><code>{`<GooglePreferredSourceDeeplink
  url="your-site.com"
  variant="button"
  label="선호하는 출처로 추가"
  theme="dark"
/>`}</code></pre>
      </div>

      <!-- 3. Outline / Ghost Button -->
      <div class="example-card">
        <div class="example-header">
          <h4>Outline / Ghost Pill</h4>
          <span class="badge-tag">variant="outline"</span>
        </div>
        <p class="example-desc">Transparent background that inherits any surface with a Google-blue hover accent.</p>
        <div class="example-preview center-preview">
          <GooglePreferredSourceDeeplink
            url={exampleSite}
            variant="outline"
            label="Add as Preferred Source"
          />
        </div>
        <pre class="code-block"><code>{`<GooglePreferredSourceDeeplink
  url="your-site.com"
  variant="outline"
  label="Add as Preferred Source"
/>`}</code></pre>
      </div>

      <!-- 4. Google Gradient Glow Button -->
      <div class="example-card">
        <div class="example-header">
          <h4>Google Gradient Glow</h4>
          <span class="badge-tag special">variant="glow"</span>
        </div>
        <p class="example-desc">Integrated 4-color Google gradient border with glowing aura on hover.</p>
        <div class="example-preview center-preview dark-bg">
          <GooglePreferredSourceDeeplink
            url={exampleSite}
            variant="glow"
            label="Follow on Google Search"
            theme="dark"
          />
        </div>
        <pre class="code-block"><code>{`<GooglePreferredSourceDeeplink
  url="your-site.com"
  variant="glow"
  label="Follow on Google Search"
  theme="dark"
/>`}</code></pre>
      </div>

      <!-- 5. Card-Style Badge -->
      <div class="example-card">
        <div class="example-header">
          <h4>Vector Badge Card</h4>
          <span class="badge-tag">variant="badge"</span>
        </div>
        <p class="example-desc">Card-style container with scalable vector SVG icon and razor-sharp typography.</p>
        <div class="example-preview center-preview">
          <GooglePreferredSourceDeeplink
            url={exampleSite}
            variant="badge"
            label="Add as a preferred source on Google"
          />
        </div>
        <pre class="code-block"><code>{`<GooglePreferredSourceDeeplink
  url="your-site.com"
  variant="badge"
  label="Add as a preferred source on Google"
/>`}</code></pre>
      </div>

      <!-- 6. Compact Minimal Trigger -->
      <div class="example-card">
        <div class="example-header">
          <h4>Minimal Inline Chip</h4>
          <span class="badge-tag">variant="minimal"</span>
        </div>
        <p class="example-desc">Ultra-compact micro-button for author bylines, header bars, or breadcrumbs.</p>
        <div class="example-preview center-preview">
          <GooglePreferredSourceDeeplink
            url={exampleSite}
            variant="minimal"
            size="sm"
            label="Follow Source"
          />
        </div>
        <pre class="code-block"><code>{`<GooglePreferredSourceDeeplink
  url="your-site.com"
  variant="minimal"
  size="sm"
  label="Follow Source"
/>`}</code></pre>
      </div>
    </div>
  </div>

  <!-- TAB 2: CUSTOM LAYOUTS -->
  <div class="tab-pane" id="tab-layouts">
    <div class="examples-grid">
      <!-- 1. Google 4-Color Gradient Glow Card -->
      <div class="example-card">
        <div class="example-header">
          <h4>Google Gradient Card</h4>
          <span class="badge-tag special">Popular</span>
        </div>
        <p class="example-desc">Card with radiant Google gradient background and vector pill button.</p>
        <div class="example-preview center-preview aura-stage">
          <div class="google-aura-card">
            <div class="aura-glow" aria-hidden="true"></div>
            <div class="aura-content">
              <span class="aura-title">Never miss a top story</span>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="pill"
                label="Follow on Google"
                theme="light"
              />
            </div>
          </div>
        </div>
        <pre class="code-block"><code>{`<div class="google-aura-card">
  <div class="aura-glow"></div>
  <div class="aura-content">
    <span>Never miss a top story</span>
    <GooglePreferredSourceDeeplink
      url="your-site.com"
      variant="pill"
      label="Follow on Google"
    />
  </div>
</div>`}</code></pre>
      </div>

      <!-- 2. Frosted Glass Reader Banner -->
      <div class="example-card">
        <div class="example-header">
          <h4>Frosted Glass Reader Banner</h4>
          <span class="badge-tag special">Glassmorphism</span>
        </div>
        <p class="example-desc">Backdrop-filtered floating notification banner with live reader status.</p>
        <div class="example-preview center-preview mesh-stage">
          <div class="glass-toast">
            <div class="toast-meta">
              <span class="toast-dot"></span>
              <strong>Reading on Magnifito?</strong>
            </div>
            <GooglePreferredSourceDeeplink
              url={exampleSite}
              variant="outline"
              size="sm"
              label="Add to Google"
              class="glass-btn"
            />
          </div>
        </div>
        <pre class="code-block"><code>{`<div class="glass-toast">
  <div class="toast-meta">
    <span class="toast-dot"></span>
    <strong>Reading on Magnifito?</strong>
  </div>
  <GooglePreferredSourceDeeplink
    url="your-site.com"
    variant="outline"
    size="sm"
    label="Add to Google"
  />
</div>`}</code></pre>
      </div>

      <!-- 3. Minimalist Editorial Masthead -->
      <div class="example-card">
        <div class="example-header">
          <h4>Editorial Publisher Callout</h4>
          <span class="badge-tag">Editorial</span>
        </div>
        <p class="example-desc">Refined serif journalism layout with author attribution and button trigger.</p>
        <div class="example-preview center-preview">
          <div class="editorial-box">
            <div class="editorial-quote">"Independent journalism powered by our readership."</div>
            <div class="editorial-footer">
              <span class="editorial-byline">MAGNIFITO EDITORIAL</span>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="pill"
                size="sm"
                label="Preferred Source"
              />
            </div>
          </div>
        </div>
        <pre class="code-block"><code>{`<div class="editorial-box">
  <p>"Independent journalism powered by readers."</p>
  <div class="editorial-footer">
    <span>MAGNIFITO EDITORIAL</span>
    <GooglePreferredSourceDeeplink
      url="your-site.com"
      variant="pill"
      size="sm"
      label="Preferred Source"
    />
  </div>
</div>`}</code></pre>
      </div>
    </div>
  </div>

  <!-- TAB 3: EXOTIC & EXPERIMENTAL -->
  <div class="tab-pane" id="tab-exotic">
    <div class="examples-grid">
      <!-- 1. Cyberpunk Terminal HUD -->
      <div class="example-card">
        <div class="example-header">
          <h4>Cyberpunk Terminal HUD</h4>
          <span class="badge-tag exotic">Exotic</span>
        </div>
        <p class="example-desc">Monospace cyber deck with CRT scanlines, neon glowing borders, and live telemetry status.</p>
        <div class="example-preview center-preview cyber-stage">
          <div class="cyber-terminal">
            <div class="cyber-topbar">
              <span class="cyber-dot green"></span>
              <span class="cyber-title">FEED_STREAM // PREF_SOURCE</span>
              <span class="cyber-status">ONLINE</span>
            </div>
            <div class="cyber-body">
              <div class="cyber-code">&gt; LINK_PROTOCOL: ESTABLISHED</div>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="raw"
                class="cyber-custom-trigger"
              >
                <GoogleIcon size={18} />
                <span>INITIATE_PREF_SOURCE →</span>
              </GooglePreferredSourceDeeplink>
            </div>
          </div>
        </div>
        <pre class="code-block"><code>{`<div class="cyber-terminal">
  <div class="cyber-body">
    <code>&gt; LINK_PROTOCOL: ACTIVE</code>
    <GooglePreferredSourceDeeplink url="your-site.com" variant="raw" class="cyber-btn">
      <GoogleIcon size={18} />
      <span>INITIATE_PREF_SOURCE →</span>
    </GooglePreferredSourceDeeplink>
  </div>
</div>`}</code></pre>
      </div>

      <!-- 2. 3D Holographic Perspective Card -->
      <div class="example-card">
        <div class="example-header">
          <h4>3D Holographic Foil Card</h4>
          <span class="badge-tag exotic">3D Motion</span>
        </div>
        <p class="example-desc">Interactive 3D tilt perspective with iridescent specular shimmer on cursor hover.</p>
        <div class="example-preview center-preview">
          <div class="holo-card" id="holoCard">
            <div class="holo-foil" aria-hidden="true"></div>
            <div class="holo-inner">
              <div class="holo-badge-header">
                <span class="holo-star">✦</span>
                <span class="holo-label">GOOGLE SEARCH SIGNAL</span>
              </div>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="pill"
                label="선호하는 출처로 등록"
                theme="light"
              />
            </div>
          </div>
        </div>
        <pre class="code-block"><code>{`<div class="holo-card">
  <div class="holo-foil"></div>
  <div class="holo-inner">
    <span>✦ GOOGLE SEARCH SIGNAL</span>
    <GooglePreferredSourceDeeplink
      url="your-site.com"
      variant="pill"
      label="선호하는 출처로 등록"
    />
  </div>
</div>`}</code></pre>
      </div>

      <!-- 3. Sticky Floating Action Pill (FAB) -->
      <div class="example-card">
        <div class="example-header">
          <h4>Sticky Floating Reader FAB</h4>
          <span class="badge-tag exotic">Interactive</span>
        </div>
        <p class="example-desc">Floating action pill for fixed viewports with pulse micro-animation.</p>
        <div class="example-preview center-preview">
          <div class="floating-fab-container">
            <div class="fab-pulse" aria-hidden="true"></div>
            <GooglePreferredSourceDeeplink
              url={exampleSite}
              variant="pill"
              label="Follow on Google"
              theme="dark"
              class="fab-pill"
            />
          </div>
        </div>
        <pre class="code-block"><code>{`<div class="floating-fab-container">
  <div class="fab-pulse"></div>
  <GooglePreferredSourceDeeplink
    url="your-site.com"
    variant="pill"
    label="Follow on Google"
    theme="dark"
    class="fab-pill"
  />
</div>`}</code></pre>
      </div>
    </div>
  </div>
</div>

<script>
  // Tab switcher
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = `tab-${btn.dataset.tab}`;
      tabButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      tabPanes.forEach((p) => p.classList.remove('active'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const targetPane = document.getElementById(targetId);
      if (targetPane) targetPane.classList.add('active');
    });
  });

  // 3D Tilt interactive effect
  const holoCard = document.getElementById('holoCard');
  if (holoCard) {
    holoCard.addEventListener('mousemove', (e) => {
      const rect = holoCard.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      const rotateX = -(y / rect.height) * 20;
      const rotateY = (x / rect.width) * 20;
      holoCard.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    });
    holoCard.addEventListener('mouseleave', () => {
      holoCard.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
    });
  }
</script>

<style>
  .showcase-container {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .showcase-nav {
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    width: fit-content;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-btn.active {
    background: var(--accent);
    color: #0b0f19;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .tab-pane {
    display: none;
  }

  .tab-pane.active {
    display: block;
    animation: fadeIn 0.25s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .examples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .example-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }

  .example-card:hover {
    border-color: var(--line-strong, rgba(255, 255, 255, 0.2));
  }

  .example-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .example-header h4 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .badge-tag {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.01em;
  }

  .badge-tag.special {
    background: rgba(66, 133, 244, 0.15);
    color: #8ab4f8;
    border: 1px solid rgba(66, 133, 244, 0.3);
  }

  .badge-tag.exotic {
    background: rgba(234, 67, 53, 0.15);
    color: #f28b82;
    border: 1px solid rgba(234, 67, 53, 0.3);
  }

  .example-desc {
    margin: 0;
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .example-preview {
    min-height: 110px;
    padding: 1.25rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px dashed var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .example-preview.dark-bg {
    background: #0d1117;
  }

  .code-block {
    margin: 0;
    padding: 0.85rem;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    font-size: 0.76rem;
    overflow-x: auto;
  }

  /* Google Aura Glow */
  .aura-stage {
    background: #090d16;
  }

  .google-aura-card {
    position: relative;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    background: #151922;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
  }

  .aura-glow {
    position: absolute;
    inset: -2px;
    border-radius: 18px;
    background: linear-gradient(135deg, #4285f4, #ea4335, #fbbc05, #34a853);
    opacity: 0.45;
    filter: blur(10px);
    z-index: 0;
    transition: opacity 0.3s ease;
  }

  .google-aura-card:hover .aura-glow {
    opacity: 0.85;
  }

  .aura-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .aura-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #e8eaed;
  }

  /* Frosted Glass Toast */
  .mesh-stage {
    background: radial-gradient(circle at top left, #1a237e 0%, #0d1117 70%);
  }

  .glass-toast {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.65rem 1.25rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .toast-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.84rem;
    color: #ffffff;
  }

  .toast-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34a853;
    box-shadow: 0 0 8px #34a853;
  }

  :global(.glass-btn) {
    border-color: rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
  }

  :global(.glass-btn:hover) {
    background: rgba(255, 255, 255, 0.15) !important;
    border-color: #ffffff !important;
  }

  /* Editorial Box */
  .editorial-box {
    width: 100%;
    padding: 1.1rem;
    border-top: 2px solid #1a1a1a;
    border-bottom: 2px solid #1a1a1a;
    background: #fbfbf9;
    color: #1a1a1a;
    font-family: 'Georgia', serif;
  }

  .editorial-quote {
    font-style: italic;
    font-size: 0.92rem;
    margin-bottom: 0.85rem;
  }

  .editorial-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .editorial-byline {
    font-size: 0.75rem;
    font-weight: bold;
    letter-spacing: 0.06em;
    color: #555;
  }

  /* Cyberpunk Terminal */
  .cyber-stage {
    background: #020608;
  }

  .cyber-terminal {
    width: 100%;
    background: #050d10;
    border: 1px solid #00ff66;
    box-shadow: 0 0 15px rgba(0, 255, 102, 0.25);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    overflow: hidden;
  }

  .cyber-topbar {
    background: #00ff66;
    color: #020608;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .cyber-body {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .cyber-code {
    font-size: 0.78rem;
    color: #00ff66;
    text-shadow: 0 0 5px #00ff66;
  }

  .cyber-custom-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    background: rgba(0, 255, 102, 0.1);
    border: 1px solid #00ff66;
    color: #00ff66;
    font-size: 0.78rem;
    font-weight: bold;
    text-decoration: none;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .cyber-custom-trigger:hover {
    background: #00ff66;
    color: #020608;
    box-shadow: 0 0 10px #00ff66;
  }

  /* 3D Holo Card */
  .holo-card {
    position: relative;
    padding: 1.25rem 1.5rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #1e2430 0%, #0e121a 100%);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out;
    cursor: pointer;
  }

  .holo-foil {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: linear-gradient(115deg, transparent 20%, rgba(255, 0, 150, 0.2) 40%, rgba(0, 255, 255, 0.25) 60%, transparent 80%);
    pointer-events: none;
    opacity: 0.6;
  }

  .holo-inner {
    position: relative;
    transform: translateZ(30px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .holo-badge-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
