---
import { languages, getAssetPath } from '../data/languages';

const assetLanguages = languages.filter((l) => l.hasAssets);
---

<div class="gallery">
  {assetLanguages.map((lang) => (
    <div class="asset-card">
      <h3>{lang.name}</h3>
      <div class="variants">
        <div class="asset-preview light">
          <img
            src={getAssetPath(lang, 'light')}
            alt={`${lang.name} light badge`}
            loading="lazy"
          />
        </div>
        <div class="asset-preview dark">
          <img
            src={getAssetPath(lang, 'dark')}
            alt={`${lang.name} dark badge`}
            loading="lazy"
          />
        </div>
      </div>
      <details>
        <summary>Embed code</summary>
        <pre><code>{`<GooglePreferredSourceDeeplink url="your-site.com">
  <img src="${getAssetPath(lang, 'light')}" alt="Add as preferred source" />
</GooglePreferredSourceDeeplink>`}</code></pre>
      </details>
    </div>
  ))}
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .asset-card {
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }
  .asset-card h3 {
    margin: 0 0 0.75rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.98rem;
    font-weight: 800;
  }
  .variants {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .asset-preview {
    padding: 0.5rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
  }
  .asset-preview.light {
    background: #ffffff;
    border: 1px solid var(--line);
  }
  .asset-preview.dark {
    background: #121416;
  }
  .asset-preview img {
    max-width: 100%;
    height: auto;
  }
  .asset-card details {
    margin-top: 0.75rem;
  }
  .asset-card summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 800;
  }
  .asset-card pre {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
