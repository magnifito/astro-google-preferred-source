---
import GooglePreferredSourceDeeplink from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceDeeplink.astro';

const exampleSite = 'magnifito.github.io';
---

<div class="placement-guide">
  <div class="placement-cards">
    <!-- 1. Article End (Highest Conversion) -->
    <div class="placement-card featured">
      <div class="card-header-bar">
        <div class="placement-badge highest">🔥 Highest Conversion</div>
        <h3>1. End of Article / Post</h3>
        <p class="placement-why">
          <strong>Why it works:</strong> Peak intent. When a reader reaches the end of your story, their trust and satisfaction with your reporting are at their absolute highest.
        </p>
      </div>

      <!-- VISUAL PAGE GRAPHIC: Full Article Page Layout -->
      <div class="browser-graphic-frame">
        <div class="browser-header">
          <div class="window-controls">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">your-site.com/articles/state-of-search</div>
        </div>
        <div class="page-wireframe article-page-wireframe">
          <div class="wf-navbar">
            <div class="wf-logo"></div>
            <div class="wf-nav-items"><div></div><div></div><div></div></div>
          </div>
          <div class="wf-article-body">
            <div class="wf-article-title"></div>
            <div class="wf-article-sub"></div>
            <div class="wf-hero-img"></div>
            <div class="wf-text-block">
              <div class="wf-line full"></div>
              <div class="wf-line full"></div>
              <div class="wf-line three-quarter"></div>
            </div>
            
            <!-- HIGHLIGHTED PLACEMENT TARGET -->
            <div class="wf-target-zone highlight-article-end">
              <div class="target-indicator">
                <span class="target-pin">📍</span>
                <span class="target-label">OPTIMAL PLACEMENT ZONE (100% READ)</span>
              </div>
              <div class="target-content">
                <span class="target-cta-text">Enjoyed this investigation?</span>
                <GooglePreferredSourceDeeplink
                  url={exampleSite}
                  variant="pill"
                  label="Follow on Google Search"
                  theme="dark"
                />
              </div>
            </div>

            <div class="wf-post-meta">
              <div class="wf-author-chip"></div>
              <div class="wf-share-icons"></div>
            </div>
          </div>
        </div>
      </div>

      <details class="code-reveal">
        <summary class="code-reveal-summary">
          <span class="summary-left">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>View code snippet</span>
          </span>
          <span class="summary-chevron">▼</span>
        </summary>
        <div class="snippet-wrapper">
          <pre><code>{`<article class="story">
  <h1>Your Article Title</h1>
  <p>Article content...</p>
  
  <!-- Place right at the conclusion before comments/related stories -->
  <aside class="story-footer-optin">
    <h3>Never miss our next story</h3>
    <GooglePreferredSourceDeeplink
      url="your-site.com"
      variant="pill"
      label="Follow on Google Search"
    />
  </aside>
</article>`}</code></pre>
          <button type="button" class="copy-snippet-btn" aria-label="Copy snippet">Copy</button>
        </div>
      </details>
    </div>

    <!-- 2. Header Navbar (Maximum Visibility) -->
    <div class="placement-card">
      <div class="card-header-bar">
        <div class="placement-badge">👁️ Maximum Visibility</div>
        <h3>2. Header / Top Navigation</h3>
        <p class="placement-why">
          <strong>Why it works:</strong> Zero-scroll presence. Visible on every page visit without scrolling, right alongside search, theme toggles, and social icons.
        </p>
      </div>

      <!-- VISUAL PAGE GRAPHIC: Header Layout -->
      <div class="browser-graphic-frame">
        <div class="browser-header">
          <div class="window-controls">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">your-site.com</div>
        </div>
        <div class="page-wireframe header-page-wireframe">
          <div class="wf-navbar highlighted-navbar">
            <div class="wf-logo text-logo">MAGNIFITO</div>
            <div class="wf-nav-items">
              <span class="wf-link">News</span>
              <span class="wf-link">Opinion</span>
              <span class="wf-link">Tech</span>
            </div>
            <!-- HIGHLIGHTED PLACEMENT TARGET -->
            <div class="wf-target-zone highlight-header-action">
              <div class="target-indicator small">
                <span class="target-pin">📍</span>
                <span class="target-label">NAV ACTION</span>
              </div>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="outline"
                size="sm"
                label="Follow"
              />
            </div>
          </div>
          <div class="wf-hero-area">
            <div class="wf-hero-headline"></div>
            <div class="wf-hero-grid">
              <div class="wf-grid-card"></div>
              <div class="wf-grid-card"></div>
              <div class="wf-grid-card"></div>
            </div>
          </div>
        </div>
      </div>

      <details class="code-reveal">
        <summary class="code-reveal-summary">
          <span class="summary-left">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>View code snippet</span>
          </span>
          <span class="summary-chevron">▼</span>
        </summary>
        <div class="snippet-wrapper">
          <pre><code>{`<header class="site-header">
  <Logo />
  <nav class="nav-links">
    <a href="/news">News</a>
    <GooglePreferredSourceDeeplink
      url="your-site.com"
      variant="outline"
      size="sm"
      label="Follow"
    />
  </nav>
</header>`}</code></pre>
          <button type="button" class="copy-snippet-btn" aria-label="Copy snippet">Copy</button>
        </div>
      </details>
    </div>

    <!-- 3. Floating Reader Toast (High Engagement) -->
    <div class="placement-card">
      <div class="card-header-bar">
        <div class="placement-badge">⚡ High Engagement</div>
        <h3>3. Scroll-Triggered Floating Pill</h3>
        <p class="placement-why">
          <strong>Why it works:</strong> Catches actively engaged readers as they scroll past 50% of an article, offering an unobtrusive floating reminder.
        </p>
      </div>

      <!-- VISUAL PAGE GRAPHIC: Floating Banner on Scroll -->
      <div class="browser-graphic-frame">
        <div class="browser-header">
          <div class="window-controls">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">your-site.com/deep-dive (60% scrolled)</div>
        </div>
        <div class="page-wireframe floating-page-wireframe">
          <div class="wf-scroll-progress-bar"></div>
          <div class="wf-blurred-article">
            <div class="wf-line full"></div>
            <div class="wf-line full"></div>
            <div class="wf-line half"></div>
            <div class="wf-line full"></div>
            <div class="wf-line three-quarter"></div>
          </div>
          
          <!-- HIGHLIGHTED PLACEMENT TARGET -->
          <div class="wf-target-zone highlight-floating-pill">
            <div class="target-indicator small">
              <span class="target-pin">📍</span>
              <span class="target-label">FLOATING DOCK (50%+ SCROLL)</span>
            </div>
            <div class="glass-floating-pill">
              <span class="pulse-dot"></span>
              <span class="dock-text">Enjoying this story?</span>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="pill"
                size="sm"
                label="Add to Google"
                theme="dark"
              />
            </div>
          </div>
        </div>
      </div>

      <details class="code-reveal">
        <summary class="code-reveal-summary">
          <span class="summary-left">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>View code snippet</span>
          </span>
          <span class="summary-chevron">▼</span>
        </summary>
        <div class="snippet-wrapper">
          <pre><code>{`<!-- Sticky bottom dock or scroll-triggered toast -->
<div class="floating-reader-dock">
  <span class="indicator">🟢</span>
  <span>Enjoying this story?</span>
  <GooglePreferredSourceDeeplink
    url="your-site.com"
    variant="pill"
    size="sm"
    label="Add to Google"
  />
</div>`}</code></pre>
          <button type="button" class="copy-snippet-btn" aria-label="Copy snippet">Copy</button>
        </div>
      </details>
    </div>

    <!-- 4. Author Bio & Editorial Byline (Personal Trust) -->
    <div class="placement-card">
      <div class="card-header-bar">
        <div class="placement-badge">✍️ Personal Trust</div>
        <h3>4. Author Bio / Columnist Card</h3>
        <p class="placement-why">
          <strong>Why it works:</strong> Connects author credibility directly with publication loyalty for opinion columns, newsletters, and beat reporting.
        </p>
      </div>

      <!-- VISUAL PAGE GRAPHIC: Author Column Layout -->
      <div class="browser-graphic-frame">
        <div class="browser-header">
          <div class="window-controls">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">your-site.com/opinion/alex-kirov</div>
        </div>
        <div class="page-wireframe author-page-wireframe">
          <div class="wf-column-kicker">OPINION & ANALYSIS</div>
          <div class="wf-column-title">The Future of Preferred Web Discovery</div>
          
          <!-- HIGHLIGHTED PLACEMENT TARGET -->
          <div class="wf-target-zone highlight-author-box">
            <div class="target-indicator small">
              <span class="target-pin">📍</span>
              <span class="target-label">AUTHOR TRUST LOCKUP</span>
            </div>
            <div class="author-box-content">
              <div class="author-avatar-badge">AK</div>
              <div class="author-info">
                <span class="author-name">Alex Kirov</span>
                <span class="author-title">Senior Tech Columnist</span>
              </div>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="minimal"
                size="sm"
                label="Follow Publication"
              />
            </div>
          </div>

          <div class="wf-text-block">
            <div class="wf-line full"></div>
            <div class="wf-line three-quarter"></div>
          </div>
        </div>
      </div>

      <details class="code-reveal">
        <summary class="code-reveal-summary">
          <span class="summary-left">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>View code snippet</span>
          </span>
          <span class="summary-chevron">▼</span>
        </summary>
        <div class="snippet-wrapper">
          <pre><code>{`<div class="author-card">
  <img src={author.avatar} alt={author.name} />
  <div>
    <h4>{author.name}</h4>
    <p>{author.bio}</p>
  </div>
  <GooglePreferredSourceDeeplink
    url="your-site.com"
    variant="minimal"
    size="sm"
    label="Follow Publication"
  />
</div>`}</code></pre>
          <button type="button" class="copy-snippet-btn" aria-label="Copy snippet">Copy</button>
        </div>
      </details>
    </div>

    <!-- 5. Email Newsletters & Social Bios (Off-Site Reach) -->
    <div class="placement-card">
      <div class="card-header-bar">
        <div class="placement-badge">📬 Off-Site Reach</div>
        <h3>5. Email Newsletters & Social Bios</h3>
        <p class="placement-why">
          <strong>Why it works:</strong> Email clients block JavaScript. The deeplink generates a direct URL that triggers Google preference confirmation in 1 click.
        </p>
      </div>

      <!-- VISUAL PAGE GRAPHIC: Email Newsletter Client -->
      <div class="browser-graphic-frame">
        <div class="browser-header email-header">
          <div class="window-controls">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">📬 Mail Client — Weekly Digest #42</div>
        </div>
        <div class="page-wireframe newsletter-page-wireframe">
          <div class="email-meta-bar">
            <div class="email-avatar">M</div>
            <div class="email-headers">
              <span class="email-from"><strong>Magnifito News</strong> &lt;newsletter@magnifito.com&gt;</span>
              <span class="email-subject">This Week in Web Development & AI</span>
            </div>
          </div>
          <div class="email-body-preview">
            <div class="wf-line full"></div>
            <div class="wf-line three-quarter"></div>
          </div>

          <!-- HIGHLIGHTED PLACEMENT TARGET -->
          <div class="wf-target-zone highlight-newsletter-footer">
            <div class="target-indicator small">
              <span class="target-pin">📍</span>
              <span class="target-label">NO-JS DEEPLINK FOOTER</span>
            </div>
            <div class="newsletter-footer-box">
              <p class="newsletter-cta">Prefer getting stories directly on Google Search?</p>
              <GooglePreferredSourceDeeplink
                url={exampleSite}
                variant="button"
                size="sm"
                label="Add as a Preferred Source →"
                theme="light"
              />
            </div>
          </div>
        </div>
      </div>

      <details class="code-reveal">
        <summary class="code-reveal-summary">
          <span class="summary-left">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>View code snippet</span>
          </span>
          <span class="summary-chevron">▼</span>
        </summary>
        <div class="snippet-wrapper">
          <pre><code>{`<!-- Inside email templates or Linktree/social bio -->
<div class="email-footer">
  <p>Read our stories first in Google Search:</p>
  <GooglePreferredSourceDeeplink
    url="your-site.com"
    variant="button"
    label="Add us as a Preferred Source →"
  />
</div>`}</code></pre>
          <button type="button" class="copy-snippet-btn" aria-label="Copy snippet">Copy</button>
        </div>
      </details>
    </div>
  </div>

  <div class="placement-tips-banner">
    <div class="tips-icon">💡</div>
    <div class="tips-content">
      <h4>Publisher Placement Rule of Thumb</h4>
      <ul>
        <li><strong>Rule of 2:</strong> Use <strong>1 primary callout</strong> at the end of articles (where intent is 100%), and <strong>1 compact touchpoint</strong> in the header or footer.</li>
        <li><strong>Always clarify the benefit:</strong> Use copy like <em>"See our reporting first on Google Search & Top Stories"</em> rather than generic labels.</li>
        <li><strong>Adaptive vector styles:</strong> Stadium pills (`variant="pill"`) and outline buttons (`variant="outline"`) fit seamlessly into both light and dark themes without jarring image boxes.</li>
      </ul>
    </div>
  </div>
</div>

<script>
  // Copy button handler for placement snippets
  document.querySelectorAll('.snippet-wrapper').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.copy-snippet-btn');
    const code = box.querySelector('code');
    if (!btn || !code) return;
    const originalText = btn.textContent || 'Copy';

    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const text = code.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.textContent = '✓ Copied!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>

<style>
  .placement-guide {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .placement-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .placement-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .placement-card:hover {
    border-color: var(--line-strong, rgba(255, 255, 255, 0.2));
    transform: translateY(-2px);
  }

  .placement-card.featured {
    border-color: rgba(66, 133, 244, 0.35);
    box-shadow: 0 6px 24px rgba(66, 133, 244, 0.1);
  }

  .card-header-bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .placement-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--muted);
  }

  .placement-badge.highest {
    background: rgba(234, 67, 53, 0.15);
    color: #ff7666;
    border: 1px solid rgba(234, 67, 53, 0.3);
  }

  .placement-card h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .placement-why {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .placement-why strong {
    color: var(--text);
  }

  /* BROWSER / PAGE GRAPHIC WIREFRAME */
  .browser-graphic-frame {
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
  }

  .browser-header {
    background: #161b22;
    padding: 0.45rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-controls {
    display: flex;
    gap: 5px;
  }

  .window-controls span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .browser-address {
    font-size: 0.7rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, monospace;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .page-wireframe {
    padding: 1rem;
    position: relative;
    background: #090d14;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 200px;
  }

  /* Wireframe Atoms */
  .wf-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .wf-logo {
    width: 60px;
    height: 12px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
  }

  .wf-logo.text-logo {
    width: auto;
    height: auto;
    font-weight: 900;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--text);
    background: transparent;
  }

  .wf-nav-items {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wf-nav-items div {
    width: 28px;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
  }

  .wf-link {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .wf-article-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .wf-article-title {
    width: 80%;
    height: 14px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
  }

  .wf-article-sub {
    width: 50%;
    height: 8px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
  }

  .wf-hero-img {
    width: 100%;
    height: 50px;
    background: linear-gradient(135deg, rgba(66, 133, 244, 0.15), rgba(52, 168, 83, 0.15));
    border-radius: 6px;
  }

  .wf-text-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .wf-line {
    height: 5px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.08);
  }

  .wf-line.full { width: 100%; }
  .wf-line.three-quarter { width: 75%; }
  .wf-line.half { width: 50%; }

  .wf-post-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.25rem;
  }

  .wf-author-chip {
    width: 40px;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
  }

  /* TARGET CALLOUT ZONES */
  .wf-target-zone {
    position: relative;
    border-radius: 10px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    border: 1.5px dashed #4285f4;
    background: rgba(66, 133, 244, 0.06);
    box-shadow: 0 0 16px rgba(66, 133, 244, 0.15);
    animation: targetGlow 3s infinite alternate ease-in-out;
  }

  @keyframes targetGlow {
    0% { border-color: rgba(66, 133, 244, 0.5); box-shadow: 0 0 8px rgba(66, 133, 244, 0.1); }
    100% { border-color: rgba(66, 133, 244, 1); box-shadow: 0 0 20px rgba(66, 133, 244, 0.25); }
  }

  .target-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    font-weight: 800;
    color: #8ab4f8;
    letter-spacing: 0.04em;
    background: rgba(66, 133, 244, 0.18);
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
  }

  .target-indicator.small {
    font-size: 0.6rem;
    padding: 0.15rem 0.4rem;
  }

  .target-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  .target-cta-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: #e8eaed;
  }

  /* Header Layout */
  .highlight-header-action {
    padding: 0.25rem 0.4rem;
    flex-direction: row;
    gap: 0.4rem;
  }

  .wf-hero-area {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wf-hero-headline {
    width: 60%;
    height: 12px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }

  .wf-hero-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
