---
interface Props {
  code: string;
  label?: string;
}
const { code, label = 'Copy' } = Astro.props;
---

<div class="copybox">
  <pre><code>{code}</code></pre>
  <button class="copy-btn" type="button">{label}</button>
</div>

<style>
  .copybox {
    position: relative;
    min-width: 0;
    margin: 0.5rem 0;
  }
  .copybox pre {
    margin: 0;
    min-height: 3.25rem;
    padding-right: 5.8rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    min-height: 2.15rem;
    background: #ffffff;
    color: var(--ink);
    border: 1px solid #c8d0d9;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 800;
  }
  .copy-btn:hover {
    border-color: #ffffff;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.18);
  }
  @media (max-width: 520px) {
    .copybox pre {
      padding-top: 3rem;
      padding-right: 1rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.copybox').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('.copy-btn');
    const code = box.querySelector('code');
    if (!btn || !code) return;
    const original = btn.textContent || 'Copy';
    btn.addEventListener('click', async () => {
      const text = code.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      btn.textContent = 'Copied!';
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    });
  });
</script>
