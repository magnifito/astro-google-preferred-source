---

<div class="demo">
  <button class="button" id="advanced-trigger" type="button">
    Add as preferred source (custom button)
  </button>
  <p class="note">
    This button only works when the integration is set to <code>mode: 'advanced'</code>.
    The standard mode used on this page loads the auto-render script, so the advanced
    callback queue is not available here.
  </p>
</div>

<pre><code>{`---
// Use mode: 'advanced' in astro.config.mjs
---

<button id="advanced-trigger">Add as preferred source</button>

<script>
  import { init, addPreferredSource } from '@puralex/astro-google-preferred-source/client';

  init({ theme: 'dark', lang: 'en' });

  document
    .getElementById('advanced-trigger')
    ?.addEventListener('click', () => addPreferredSource());
</script>`}</code></pre>
