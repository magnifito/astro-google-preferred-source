---
interface Props {
  title?: string;
}
const { title = '@puralex/astro-google-preferred-source' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Astro plugin for the Google Search preferred sources button. Turn Google readers into loyal followers in one command." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #202124;
        --muted: #5f6368;
        --accent: #1a73e8;
        --card: #f8f9fa;
        --border: #dadce0;
        --google-blue: #4285f4;
        --google-red: #ea4335;
        --google-yellow: #f9ab00;
        --google-green: #34a853;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: '';
        display: block;
        height: 4px;
        background: linear-gradient(
          90deg,
          var(--google-blue) 0 25%,
          var(--google-red) 25% 50%,
          var(--google-yellow) 50% 75%,
          var(--google-green) 75% 100%
        );
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3 {
        letter-spacing: -0.025em;
        line-height: 1.15;
      }
      .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 1.5rem 2rem;
      }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--accent);
        margin: 0 0 0.5rem;
      }
      .grad {
        background: linear-gradient(
          90deg,
          var(--google-blue),
          var(--google-red) 40%,
          var(--google-yellow) 65%,
          var(--google-green)
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      /* Hero */
      .hero {
        text-align: center;
        padding: 5rem 1rem 4rem;
        margin: 0 -1.5rem 4rem;
        background:
          radial-gradient(600px 300px at 15% 10%, rgba(66, 133, 244, 0.12), transparent 70%),
          radial-gradient(600px 300px at 85% 15%, rgba(52, 168, 83, 0.1), transparent 70%),
          radial-gradient(500px 260px at 50% 0%, rgba(251, 188, 4, 0.08), transparent 70%),
          linear-gradient(180deg, #f8fbff 0%, #ffffff 80%);
        border-bottom: 1px solid var(--border);
      }
      .hero h1 {
        font-size: clamp(2.2rem, 6vw, 3.6rem);
        font-weight: 800;
        margin: 0 0 1.25rem;
      }
      .hero .subtitle {
        color: var(--muted);
        font-size: clamp(1.05rem, 2.5vw, 1.3rem);
        max-width: 680px;
        margin: 0 auto 2.25rem;
      }
      .hero .copybox {
        max-width: 620px;
        margin: 0 auto;
        text-align: left;
      }
      .hero .demo {
        border: none;
        margin-top: 1.75rem;
        padding: 0.5rem;
        display: flex;
        justify-content: center;
      }
      .badges {
        margin-top: 1.75rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        justify-content: center;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 500;
      }

      /* Sections */
      section { margin: 4.5rem 0; }
      section > h2 {
        font-size: clamp(1.6rem, 4vw, 2.1rem);
        font-weight: 800;
        margin: 0 0 1rem;
      }
      section > p.lead {
        font-size: 1.1rem;
        color: var(--muted);
        max-width: 700px;
        margin-top: -0.25rem;
      }

      /* Feature grid */
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        margin: 2rem 0;
      }
      @media (min-width: 640px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (min-width: 960px) {
        .grid { grid-template-columns: repeat(4, 1fr); }
      }
      .feature {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.5rem 1.25rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .feature:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(60, 64, 67, 0.12);
      }
      .feature:nth-child(1) { border-top: 3px solid var(--google-blue); }
      .feature:nth-child(2) { border-top: 3px solid var(--google-red); }
      .feature:nth-child(3) { border-top: 3px solid var(--google-yellow); }
      .feature:nth-child(4) { border-top: 3px solid var(--google-green); }
      .feature h3 {
        margin: 0 0 0.5rem;
        font-size: 1.05rem;
        font-weight: 700;
      }
      .feature p {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .feature .stat {
        display: block;
        font-size: 2.1rem;
        font-weight: 800;
        margin-bottom: 0.35rem;
      }
      .feature:nth-child(1) .stat { color: var(--google-blue); }
      .feature:nth-child(2) .stat { color: var(--google-red); }
      .feature:nth-child(3) .stat { color: var(--google-yellow); }
      .feature:nth-child(4) .stat { color: var(--google-green); }

      /* Steps */
      .step-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-top: 2rem;
      }
      @media (min-width: 768px) {
        .step-grid { grid-template-columns: repeat(3, 1fr); }
      }
      .step {
        position: relative;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.5rem 1.25rem 1.25rem;
        background: #fff;
      }
      .step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: var(--accent);
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.75rem;
      }
      .step:nth-child(1) .step-num { background: var(--google-blue); }
      .step:nth-child(2) .step-num { background: var(--google-red); }
      .step:nth-child(3) .step-num { background: var(--google-green); }
      .step h3 {
        margin: 0 0 0.4rem;
        font-size: 1.1rem;
        font-weight: 700;
      }
      .step p {
        margin: 0 0 0.75rem;
        color: var(--muted);
        font-size: 0.95rem;
      }
      .step pre {
        margin: 0;
        font-size: 0.8rem;
      }

      /* Cards */
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.75rem;
        margin: 2rem 0;
      }
      .card h2 {
        margin-top: 0;
        font-size: 1.5rem;
        font-weight: 800;
      }
      pre {
        background: #f1f3f4;
        border: 1px solid var(--border);
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
      }
      code {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.9rem;
      }
      .demo {
        padding: 1.5rem;
        border: 1px dashed var(--muted);
        border-radius: 8px;
        margin-top: 1rem;
      }
      .button {
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.75rem 1.25rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
      }
      .note {
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 0.75rem;
      }

      /* Final CTA */
      .cta-band {
        text-align: center;
        padding: 3.5rem 1.5rem;
        border-radius: 20px;
        margin: 5rem 0 3rem;
        background:
          radial-gradient(500px 220px at 20% 0%, rgba(66, 133, 244, 0.15), transparent 70%),
          radial-gradient(500px 220px at 80% 100%, rgba(52, 168, 83, 0.12), transparent 70%),
          #f0f6ff;
        border: 1px solid #d3e3fd;
      }
      .cta-band h2 {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 800;
        margin: 0 0 0.75rem;
      }
      .cta-band p {
        color: var(--muted);
        max-width: 560px;
        margin: 0 auto 1.75rem;
      }
      .cta-band .copybox {
        max-width: 620px;
        margin: 0 auto;
        text-align: left;
      }
      .cta-links {
        margin-top: 1.5rem;
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        font-weight: 600;
      }

      footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>
