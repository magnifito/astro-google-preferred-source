---
interface Props {
  title?: string;
}
const { title = '@puralex/astro-google-preferred-source' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Astro plugin for the Google Search preferred sources button. Turn Google readers into loyal followers in one command."
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,650;6..72,760&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        color-scheme: light;
        --paper: #f6f7f3;
        --paper-strong: #edefe8;
        --ink: #171717;
        --ink-soft: #303336;
        --muted: #626972;
        --surface: #ffffff;
        --surface-muted: #f4f6f8;
        --line: #d8dee5;
        --line-strong: #b9c2cc;
        --border: var(--line);
        --blue: #2563eb;
        --red: #dc2626;
        --yellow: #c98300;
        --green: #12813a;
        --accent: var(--blue);
        --card: var(--surface);
        --fg: var(--ink);
        --shadow: 0 28px 70px rgba(23, 23, 23, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--paper);
      }

      body {
        margin: 0;
        min-width: 320px;
        font-family:
          'Inter',
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        color: var(--ink);
        background:
          linear-gradient(90deg, rgba(23, 23, 23, 0.035) 1px, transparent 1px),
          linear-gradient(180deg, #fbfcff 0, var(--paper) 42rem, #ffffff 100%);
        background-size: 96px 96px, auto;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      body::before {
        content: '';
        display: block;
        height: 5px;
        background: linear-gradient(
          90deg,
          var(--blue) 0 25%,
          var(--red) 25% 50%,
          var(--yellow) 50% 75%,
          var(--green) 75% 100%
        );
      }

      a {
        color: var(--blue);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: #1746a2;
      }

      img,
      iframe {
        max-width: 100%;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: 'Newsreader', Georgia, serif;
        font-weight: 650;
        line-height: 1;
        letter-spacing: 0;
        color: var(--ink);
      }

      p {
        margin: 0;
      }

      code,
      pre {
        font-family:
          'JetBrains Mono',
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          monospace;
      }

      code {
        font-size: 0.9em;
      }

      pre {
        margin: 0;
        padding: 1rem;
        overflow-x: auto;
        color: #eff6ff;
        background: #16191d;
        border: 1px solid #2c3238;
        border-radius: 8px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
      }

      pre code {
        font-size: 0.84rem;
        line-height: 1.65;
      }

      .container {
        width: min(100% - 2rem, 1180px);
        margin: 0 auto;
        padding-bottom: 3rem;
      }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 1.2rem 0 2.8rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: var(--ink);
        font-size: 0.94rem;
        font-weight: 800;
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        grid-template-columns: repeat(2, 0.5rem);
        grid-template-rows: repeat(2, 0.5rem);
        gap: 0.18rem;
      }

      .brand-mark span {
        display: block;
        width: 0.5rem;
        height: 0.5rem;
      }

      .brand-mark span:nth-child(1) {
        background: var(--blue);
      }

      .brand-mark span:nth-child(2) {
        background: var(--red);
      }

      .brand-mark span:nth-child(3) {
        background: var(--yellow);
      }

      .brand-mark span:nth-child(4) {
        background: var(--green);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: flex-end;
        font-size: 0.88rem;
        font-weight: 700;
      }

      .nav-links a {
        color: var(--ink-soft);
        text-decoration: none;
      }

      .nav-links a:hover {
        color: var(--blue);
      }

      .nav-cta {
        padding: 0.55rem 0.75rem;
        color: #ffffff !important;
        background: var(--ink);
        border: 1px solid var(--ink);
        border-radius: 6px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
        gap: 3rem;
        align-items: center;
        padding: 1rem 0 5rem;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0 0 1rem;
        color: var(--ink-soft);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: '';
        width: 2.3rem;
        height: 0.16rem;
        background: linear-gradient(90deg, var(--blue), var(--red), var(--yellow), var(--green));
      }

      .hero h1 {
        max-width: 11ch;
        font-size: 5.2rem;
        font-weight: 760;
      }

      .hero .subtitle {
        max-width: 42rem;
        margin-top: 1.35rem;
        color: var(--ink-soft);
        font-size: 1.25rem;
        line-height: 1.7;
      }

      .grad {
        color: var(--blue);
      }

      .hero-actions {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.8rem;
        align-items: stretch;
        max-width: 44rem;
        margin-top: 2rem;
      }

      .secondary-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.25rem;
        padding: 0.75rem 1rem;
        color: var(--ink);
        font-weight: 800;
        text-decoration: none;
        background: var(--surface);
        border: 1px solid var(--line-strong);
        border-radius: 6px;
      }

      .secondary-action:hover {
        color: var(--ink);
        border-color: var(--ink);
      }

      .hero-metrics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0;
        max-width: 43rem;
        margin: 2rem 0 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .hero-metrics div {
        padding: 1rem 1rem 1rem 0;
      }

      .hero-metrics div + div {
        padding-left: 1rem;
        border-left: 1px solid var(--line);
      }

      .hero-metrics dt {
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .hero-metrics dd {
        margin: 0.25rem 0 0;
        color: var(--ink);
        font-size: 1.1rem;
        font-weight: 800;
      }

      .hero-visual {
        min-width: 0;
      }

      .source-card {
        position: relative;
        padding: 1rem;
        background: #121416;
        border: 1px solid #2b3035;
        border-radius: 8px;
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .source-card::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
          linear-gradient(180deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: linear-gradient(180deg, #000 0, transparent 75%);
      }

      .source-card > * {
        position: relative;
      }

      .card-kicker {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        color: #b9c6d4;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .card-kicker::after {
        content: '';
        width: 5.3rem;
        height: 0.25rem;
        background: linear-gradient(90deg, var(--blue), var(--red), var(--yellow), var(--green));
      }

      .source-lockup {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: center;
        margin-top: 1.2rem;
      }

      .source-lockup h2 {
        color: #ffffff;
        font-size: 2rem;
        line-height: 1.08;
      }

      .source-lockup p {
        margin-top: 0.45rem;
        color: #b9c6d4;
        font-size: 0.95rem;
      }

      .badge-stack {
        display: grid;
        gap: 0.55rem;
        justify-items: end;
      }

      .badge-stack img {
        width: 190px;
        height: auto;
        padding: 0.45rem;
        background: #ffffff;
        border-radius: 6px;
      }

      .badge-stack img:last-child {
        background: #22262a;
        border: 1px solid #343b42;
      }

      .search-sheet {
        margin-top: 1.5rem;
        padding: 1rem;
        background: #f9fbff;
        border: 1px solid #d9e1ea;
        border-radius: 8px;
      }

      .search-bar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        height: 2.8rem;
        padding: 0 0.9rem;
        color: #5f6368;
        background: #ffffff;
        border: 1px solid #d9e1ea;
        border-radius: 999px;
        font-size: 0.92rem;
        font-weight: 700;
      }

      .lens {
        width: 0.78rem;
        height: 0.78rem;
        border: 2px solid var(--blue);
        border-radius: 50%;
        box-shadow: 0.36rem 0.36rem 0 -0.27rem var(--blue);
      }

      .result-stack {
        display: grid;
        gap: 0.85rem;
        margin-top: 1rem;
      }

      .result-row {
        padding-left: 0.85rem;
        border-left: 3px solid var(--line);
      }

      .result-row.preferred {
        border-left-color: var(--green);
      }

      .result-row strong {
        display: block;
        color: #202124;
        font-size: 0.98rem;
      }

      .result-row span {
        display: block;
        margin-top: 0.2rem;
        color: #6b7280;
        font-size: 0.85rem;
      }

      .live-button-stage,
      .demo {
        display: flex;
        justify-content: center;
        min-height: 5rem;
        margin-top: 1rem;
        padding: 1rem;
        background:
          linear-gradient(90deg, rgba(37, 99, 235, 0.08), transparent 34%),
          var(--surface-muted);
        border: 1px dashed var(--line-strong);
        border-radius: 8px;
      }

      section {
        margin: 0 0 5rem;
        scroll-margin-top: 2rem;
      }

      .section-header {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: end;
        margin-bottom: 1.6rem;
      }

      .section-header h2 {
        font-size: 3rem;
        font-weight: 760;
      }

      .section-header .lead,
      .lead {
        color: var(--muted);
        font-size: 1.06rem;
        line-height: 1.75;
      }

      .feature-grid,
      .step-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
      }

      .step-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .feature,
      .step {
        min-width: 0;
        padding: 1.2rem;
        background: rgba(255, 255, 255, 0.76);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .feature {
        display: flex;
        flex-direction: column;
        min-height: 15rem;
        border-top: 4px solid var(--blue);
      }

      .feature:nth-child(2) {
        border-top-color: var(--red);
      }

      .feature:nth-child(3) {
        border-top-color: var(--yellow);
      }

      .feature:nth-child(4) {
        border-top-color: var(--green);
      }

      .stat {
        display: block;
        margin-bottom: auto;
        color: var(--ink);
        font-family: 'Newsreader', Georgia, serif;
        font-size: 3.2rem;
        font-weight: 760;
        line-height: 0.95;
      }

      .feature h3,
      .step h3 {
        margin-top: 1.1rem;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.25;
      }

      .feature p,
      .step p {
        margin-top: 0.55rem;
        color: var(--muted);
        font-size: 0.94rem;
      }

      .step {
        background: var(--surface);
      }

      .step-num {
        display: inline-grid;
        place-items: center;
        width: 2.2rem;
        height: 2.2rem;
        color: #ffffff;
        background: var(--ink);
        border-radius: 6px;
        font-weight: 800;
      }

      .step pre {
        margin-top: 1rem;
        font-size: 0.78rem;
      }

      .note {
        max-width: 60rem;
        margin-top: 1rem;
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.7;
      }

      .tool-panel {
        padding: 1.2rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow: 0 18px 45px rgba(23, 23, 23, 0.07);
      }

      .docs-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
        gap: 1.4rem;
        align-items: start;
        padding: 1.7rem 0;
        border-top: 1px solid var(--line);
      }

      .docs-grid:last-child {
        border-bottom: 1px solid var(--line);
      }

      .docs-copy h2,
      .docs-wide h2 {
        font-size: 2rem;
        font-weight: 760;
      }

      .docs-copy p,
      .docs-wide p {
        margin-top: 0.8rem;
        color: var(--muted);
      }

      .code-stack {
        display: grid;
        gap: 0.8rem;
        min-width: 0;
      }

      .resource-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        padding: 0;
        margin: 1.4rem 0 0;
        list-style: none;
      }

      .resource-list a {
        display: block;
        min-height: 100%;
        padding: 1rem;
        color: var(--ink);
        font-weight: 800;
        text-decoration: none;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .resource-list a:hover {
        border-color: var(--ink);
      }

      .resource-list span {
        display: block;
        margin-top: 0.35rem;
        color: var(--muted);
        font-size: 0.88rem;
        font-weight: 500;
      }

      .cta-band {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 2rem;
        align-items: center;
        padding: 2rem;
        color: #ffffff;
        background: #111315;
        border: 1px solid #2d3339;
        border-radius: 8px;
      }

      .cta-band h2 {
        color: #ffffff;
        font-size: 2.8rem;
        font-weight: 760;
      }

      .cta-band p {
        margin-top: 0.8rem;
        color: #c8d0d9;
      }

      .cta-band .copybox {
        margin: 0;
      }

      .cta-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 1rem;
      }

      .cta-links a {
        display: inline-flex;
        align-items: center;
        min-height: 2.8rem;
        padding: 0.65rem 0.85rem;
        color: #ffffff;
        font-weight: 800;
        text-decoration: none;
        border: 1px solid #4a535d;
        border-radius: 6px;
      }

      footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 3rem;
        padding: 1.5rem 0 0;
        color: var(--muted);
        border-top: 1px solid var(--line);
        font-size: 0.92rem;
      }

      footer p {
        display: flex;
        gap: 0.7rem;
        flex-wrap: wrap;
      }

      @media (max-width: 980px) {
        .container {
          width: min(100% - 1.5rem, 760px);
        }

        .hero,
        .section-header,
        .docs-grid,
        .cta-band {
          grid-template-columns: 1fr;
        }

        .hero {
          padding-bottom: 4rem;
        }

        .hero h1 {
          font-size: 4rem;
        }

        .feature-grid,
        .step-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .source-lockup {
          grid-template-columns: 1fr;
        }

        .badge-stack {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          justify-items: stretch;
        }

        .badge-stack img {
          width: 100%;
        }
      }

      @media (max-width: 680px) {
        body {
          background-size: 64px 64px, auto;
        }

        .site-nav {
          align-items: flex-start;
          padding-bottom: 2rem;
        }

        .nav-links {
          gap: 0.65rem;
          font-size: 0.8rem;
        }

        .hero {
          padding-top: 0;
        }

        .hero h1 {
          max-width: none;
          font-size: 3rem;
        }

        .hero .subtitle {
          font-size: 1.05rem;
        }

        .hero-actions,
        .hero-metrics,
        .feature-grid,
        .step-grid,
        .resource-list {
          grid-template-columns: 1fr;
        }

        .hero-metrics div,
        .hero-metrics div + div {
          padding: 0.9rem 0;
          border-left: 0;
          border-top: 1px solid var(--line);
        }

        .hero-metrics div:first-child {
          border-top: 0;
        }

        .section-header h2 {
          font-size: 2.3rem;
        }

        .source-card,
        .tool-panel,
        .cta-band {
          padding: 1rem;
        }

        .source-lockup h2,
        .docs-copy h2,
        .docs-wide h2 {
          font-size: 1.75rem;
        }

        .cta-band h2 {
          font-size: 2.1rem;
        }

        footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>
