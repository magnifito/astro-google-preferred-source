---
import Layout from '../layouts/Layout.astro';
import GooglePreferredSourceButton from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceButton.astro';
import GooglePreferredSourceDeeplink from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceDeeplink.astro';
import AdvancedDemo from '../components/AdvancedDemo.astro';
---

<Layout>
  <header>
    <h1>@puralex/astro-google-preferred-source</h1>
    <p class="subtitle">
      Astro plugin for the
      <a href="https://developers.google.com/search/docs/appearance/preferred-sources">
        Google Search preferred sources
      </a>
      button.
    </p>
  </header>

  <section class="card">
    <h2>Eligibility</h2>
    <p>
      Only domain-level and subdomain-level sites can be preferred sources.
      Subdirectories like <code>example.com/blog</code> are not eligible.
      Check your site in the
      <a href="https://www.google.com/preferences/source">source preferences tool</a>
      before implementing.
    </p>
  </section>

  <section class="card">
    <h2>Installation</h2>
    <pre><code>npm install @puralex/astro-google-preferred-source</code></pre>
  </section>

  <section class="card">
    <h2>Standard button</h2>
    <p>
      Add the integration to <code>astro.config.mjs</code> and drop in the component.
      The button only renders for sites that appear in Google's source preferences tool.
    </p>
    <pre><code>{`// astro.config.mjs
import googlePreferredSource from '@puralex/astro-google-preferred-source';

export default defineConfig({
  integrations: [googlePreferredSource()],
});`}</code></pre>
    <pre><code>{`---
import GooglePreferredSourceButton from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceButton.astro';
---
<GooglePreferredSourceButton theme="dark" lang="en" />`}</code></pre>
    <div class="demo">
      <GooglePreferredSourceButton theme="dark" lang="en" />
    </div>
    <p class="note">
      Place the button where readers will see it: header, article end, or footer.
      Pair it with a short CTA and mention it in newsletters or social posts.
    </p>
  </section>

  <section class="card">
    <h2>Advanced custom trigger</h2>
    <p>Use your own button design and trigger the flow programmatically.</p>
    <AdvancedDemo />
  </section>

  <section class="card">
    <h2>Deeplink</h2>
    <p>For no-JS environments, newsletters, or social posts.</p>
    <pre><code>{`---
import GooglePreferredSourceDeeplink from '@puralex/astro-google-preferred-source/components/GooglePreferredSourceDeeplink.astro';
---
<GooglePreferredSourceDeeplink url="magnifito.github.io">
  Add as preferred source
</GooglePreferredSourceDeeplink>`}</code></pre>
    <div class="demo">
      <GooglePreferredSourceDeeplink url="magnifito.github.io">
        Add as preferred source
      </GooglePreferredSourceDeeplink>
    </div>
    <p>
      You can also use an image inside the deeplink. Google provides
      <a href="https://services.google.com/fh/files/helpcenter/google_preferred_source_badge_all_languages.zip">official translated button assets</a>
      you can download and host yourself.
    </p>
    <pre><code>{`<GooglePreferredSourceDeeplink url="magnifito.github.io">
  <img src="/path/to/button.png" alt="Add as preferred source" />
</GooglePreferredSourceDeeplink>`}</code></pre>
  </section>

  <section class="card">
    <h2>Resources</h2>
    <ul>
      <li><a href="https://www.google.com/preferences/source">Source preferences tool</a> — check site eligibility</li>
      <li><a href="https://developers.google.com/search/docs/appearance/preferred-sources">Google preferred sources docs</a></li>
      <li><a href="https://developers.google.com/static/search/docs/appearance/preferred-sources-languages.csv">Supported language codes</a></li>
      <li><a href="https://services.google.com/fh/files/helpcenter/google_preferred_source_badge_all_languages.zip">Official button assets</a></li>
      <li><a href="https://reader-revenue-demo.ue.r.appspot.com/preferred-sources/esm">Google interactive demo</a></li>
    </ul>
  </section>

  <footer>
    <p>
      <a href="https://github.com/magnifito/astro-google-preferred-source">GitHub</a>
      &middot;
      <a href="https://www.npmjs.com/package/@puralex/astro-google-preferred-source">npm</a>
    </p>
  </footer>
</Layout>
